{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env"],
  "tasks": {
    "client#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["SENTRY_AUTH_TOKEN"],
      "cache": true
    },
    "server#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "@codex/types#build": {
      "outputs": ["dist/**/*.d.ts", "dist/**/*.js"],
      "cache": true
    },
    "build": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": true
    },
    "lint:fix": {
      "cache": true
    },
    "format": {
      "cache": true
    },
    "format:fix": {
      "cache": true
    }
  }
}
