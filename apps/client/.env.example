# --- Local development defaults (override for production) ---
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_BASE_CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_BASE_SERVER_URL=http://localhost:3001
# Backward-compatible alias for NEXT_PUBLIC_BASE_SERVER_URL
NEXT_PUBLIC_SERVER_URL=

# Code execution — Judge0 CE (free, 25+ languages, no Docker)
CODE_RUNNER_PROVIDER=judge0
JUDGE0_API_URL=https://ce.judge0.com
# JUDGE0_AUTH_TOKEN=

# Optional: self-hosted Piston instead (pnpm piston:up && pnpm piston:install)
# CODE_RUNNER_PROVIDER=piston
# PISTON_API_URL=http://localhost:2000/api/v2/execute
# PISTON_API_KEY=
# PISTON_COMPILE_TIMEOUT_MS=10000
# PISTON_RUN_TIMEOUT_MS=3000

# --- Optional ---
GITHUB_CLIENT_SECRET_PROD=
GITHUB_CLIENT_SECRET_DEV=
BETTERSTACK_API_KEY=
BETTERSTACK_MONITOR_ID=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_SUPPRESS_TURBOPACK_WARNING="1"
# Links shown in UI and run-error "More details" (first non-empty wins for docs)
NEXT_PUBLIC_PORTFOLIO_URL=
NEXT_PUBLIC_CONTACT_URL=
NEXT_PUBLIC_REPO_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_STATUS_URL=
TURBO_TEAM=
TURBO_TOKEN=
