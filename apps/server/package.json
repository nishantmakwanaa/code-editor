{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon -r dotenv/config -r tsconfig-paths/register src/index.ts",
    "start": "nodemon -r dotenv/config -r tsconfig-paths/register src/index.ts",
    "start:prod": "node dist/index.js",
    "build": "rimraf dist && tsc -p tsconfig.prod.json && tsc-alias -p tsconfig.prod.json && echo Server built successfully!",
    "format": "prettier --check",
    "format:fix": "prettier --write"
  },
  "dependencies": {
    "@codex/types": "workspace:*",
    "dotenv": "^16.6.1",
    "socket.io": "^4.8.3",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.52.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0"
  }
}
